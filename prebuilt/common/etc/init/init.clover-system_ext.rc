# Clover core functionality
on init
    export TERMINFO /system_ext/etc/terminfo

on property:persist.sys.clover.boot_hash=*
    setprop ro.boot.vbmeta.digest ${persist.sys.clover.boot_hash}

# bugreport is triggered by holding down volume down, volume up and power
service clover-bugreport /system/bin/dumpstate -d -p -z
    socket dumpstate stream 0660 shell log
    class main
    user root
    disabled
    oneshot
    keycodes 114 115 116
